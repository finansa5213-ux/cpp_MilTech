# --- Заняття 36, ДЗ18 ---------------------------------------------------------
# Тік ОС 1 мс: головний цикл прокидається дрібними квантами, не заважаючи таймеру.
CONFIG_FREERTOS_HZ=1000

# Логи ESP_LOG приглушені до WARN, щоб не змішуватись із протокольними рядками в UART0.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# Повне форматування newlib (на випадок, якщо десь знадобиться %f у printf).
# Код звіту навмисно не залежить від float-форматування, але хай буде.
CONFIG_NEWLIB_NANO_FORMAT=n

# Головний таск: у нас на стеку є буфери рядків.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# C++ без винятків і RTTI — звична дисципліна для прошивок.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
